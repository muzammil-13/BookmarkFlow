{
  "manifest_version": 3,
  "name": "BookmarkFlow – Smart Bookmark Organizer",
  "version": "1.0.0",
  "description": "AI-powered bookmark organizer. Intelligently categorizes and restructures your Chrome bookmarks using Gemini or OpenRouter LLMs — all client-side.",
  "author": "BookmarkFlow",

  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "BookmarkFlow"
  },

  "side_panel": {
    "default_path": "sidepanel.html"
  },

  "permissions": [
    "bookmarks",
    "storage",
    "sidePanel",
    "tabs"
  ],

  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://openrouter.ai/*",
    "https://api.groq.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
